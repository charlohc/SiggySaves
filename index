<!DOCTYPE html>
<html lang="nb">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Låneportefølje – presentasjon</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
<style>
:root {
  color-scheme: light;
  --bg: #F2F5F9; --surface: #FFFFFF; --surface2: #E9EEF5; --ink: #13223B; --muted: #5A6A82; --line: #D3DBE6;
  --navy: #1B365D; --navy-ink: #FFFFFF; --steel: #3E6A99; --sky: #8DB0D6; --sand: #B08D57;
  --ok: #2B7A4B; --ok-bg: #DCEFE3; --bad: #B3261E; --bad-bg: #F7DEDB; --warn: #9A6A12; --warn-bg: #F6EBD3;
  --c1: #1B365D; --c2: #4F86C0; --c3: #B08D57; --c4: #8A9BB3; --c5: #2B7A4B; --c6: #B3261E;
  --serif: "Source Serif 4", Georgia, "Times New Roman", serif;
  --sans: "Public Sans", "Segoe UI", Arial, sans-serif;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #0D1828; --surface: #142338; --surface2: #1B2D47; --ink: #E4EAF2; --muted: #9AAAC0; --line: #2A3D5A;
    --navy: #2C4C7A; --navy-ink: #FFFFFF; --steel: #7FA6D1; --sky: #4F6F95; --sand: #C9A66E;
    --ok: #6CC08F; --ok-bg: #173A28; --bad: #F08A80; --bad-bg: #44201E; --warn: #E2B45C; --warn-bg: #3A2E14;
    --c1: #8DB0D6; --c2: #4F86C0; --c3: #C9A66E; --c4: #6E7F99; --c5: #6CC08F; --c6: #F08A80;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #0D1828; --surface: #142338; --surface2: #1B2D47; --ink: #E4EAF2; --muted: #9AAAC0; --line: #2A3D5A;
  --navy: #2C4C7A; --navy-ink: #FFFFFF; --steel: #7FA6D1; --sky: #4F6F95; --sand: #C9A66E;
  --ok: #6CC08F; --ok-bg: #173A28; --bad: #F08A80; --bad-bg: #44201E; --warn: #E2B45C; --warn-bg: #3A2E14;
  --c1: #8DB0D6; --c2: #4F86C0; --c3: #C9A66E; --c4: #6E7F99; --c5: #6CC08F; --c6: #F08A80;
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
*, *::before, *::after { box-sizing: inherit; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 15px; line-height: 1.5; font-variant-numeric: tabular-nums; }
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--navy); }
button, select, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--steel); outline-offset: 2px; }

/* Topplinje */
.topbar { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--navy); color: var(--navy-ink); }
.topbar-inner { max-width: 1280px; margin: 0 auto; padding: 12px 24px; display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
.brand { font-family: var(--serif); font-size: 19px; font-weight: 600; margin-right: auto; }
.brand small { font-family: var(--sans); font-weight: 400; font-size: 13px; opacity: .75; margin-left: 10px; }
.btn { border: 1px solid rgba(255,255,255,.45); background: transparent; color: var(--navy-ink); padding: 7px 14px; border-radius: 4px; cursor: pointer; white-space: nowrap; }
.btn:hover { background: rgba(255,255,255,.12); }
.btn.primary { background: #FFFFFF; color: #1B365D; border-color: #FFFFFF; font-weight: 600; }
.btn.primary:hover { background: #E9EEF5; }
.ctrl { display: flex; align-items: center; gap: 8px; font-size: 13px; }
.ctrl select { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.45); color: var(--navy-ink); border-radius: 4px; padding: 5px 8px; }
.ctrl select option { color: #13223B; background: #FFFFFF; }
.files { max-width: 1280px; margin: 0 auto; padding: 0 24px 10px; display: flex; flex-wrap: wrap; gap: 8px; }
.chip { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.3); border-radius: 999px; padding: 3px 6px 3px 12px; font-size: 13px; cursor: pointer; }
.chip.active { background: #FFFFFF; color: #1B365D; border-color: #FFFFFF; font-weight: 600; }
.chip .x { border: 0; background: transparent; cursor: pointer; padding: 0 6px; font-size: 15px; line-height: 1; color: inherit; opacity: .7; }
.chip .ref { font-size: 11px; opacity: .8; font-weight: 400; }
.tabs { background: var(--surface); border-bottom: 1px solid var(--line); position: sticky; top: calc(env(safe-area-inset-top, 0px) + var(--topbar-h, 0px)); z-index: 4; }
.tabs-inner { max-width: 1280px; margin: 0 auto; padding: 0 16px; display: flex; overflow-x: auto; }
.tab { border: 0; background: none; padding: 13px 14px 11px; border-bottom: 3px solid transparent; cursor: pointer; color: var(--muted); white-space: nowrap; font-weight: 500; }
.tab[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--sand); }
.tab:hover { color: var(--ink); }

main { max-width: 1280px; margin: 0 auto; padding: 28px 24px 64px; }
.panel { display: none; }
.panel.active { display: block; }
h2 { font-family: var(--serif); font-weight: 600; font-size: 28px; margin: 0 0 4px; letter-spacing: -.01em; }
h3 { font-size: 16px; font-weight: 600; margin: 32px 0 10px; }
.lead { color: var(--muted); margin: 0 0 22px; max-width: 75ch; }
.note { color: var(--muted); font-size: 13px; margin: 8px 0 0; }

/* Tom tilstand */
.empty { max-width: 640px; margin: 40px auto; text-align: left; }
.empty h2 { font-size: 34px; }
.drop { margin-top: 24px; border: 2px dashed var(--line); background: var(--surface); border-radius: 8px; padding: 36px 28px; }
.drop.over { border-color: var(--steel); background: var(--surface2); }
.drop p { margin: 0 0 16px; }
.drop .actions { display: flex; flex-wrap: wrap; gap: 10px; }
.btn2 { border: 1px solid var(--line); background: var(--surface); color: var(--ink); padding: 8px 16px; border-radius: 4px; cursor: pointer; }
.btn2:hover { background: var(--surface2); }
.btn2.primary { background: var(--navy); color: var(--navy-ink); border-color: var(--navy); font-weight: 600; }
.err { margin-top: 16px; background: var(--bad-bg); color: var(--bad); padding: 12px 14px; border-radius: 4px; display: none; }
.err.show { display: block; }

/* Forside */
.cover { background: var(--surface); border: 1px solid var(--line); min-height: 560px; display: grid; grid-template-columns: 10px 1fr; }
.cover .rule { background: var(--navy); }
.cover .inner { padding: 48px 56px; display: flex; flex-direction: column; gap: 28px; }
.cover .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
.cover .doc { color: var(--muted); font-size: 14px; }
.cover .logo { max-height: 64px; max-width: 220px; object-fit: contain; }
.cover .customer { font-family: var(--serif); font-size: clamp(36px, 6vw, 64px); line-height: 1.05; font-weight: 600; margin: 40px 0 0; letter-spacing: -.02em; }
.cover .title { font-family: var(--serif); font-size: 22px; color: var(--muted); margin: 0; }
.cover .stamp { display: inline-block; border: 1.5px solid var(--sand); color: var(--sand); padding: 4px 12px; border-radius: 3px; font-weight: 600; font-size: 14px; }
.cover .figs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); margin-top: auto; padding-top: 24px; gap: 24px; }
.cover .figs .v { font-family: var(--serif); font-size: 30px; font-weight: 600; }
.cover .figs .l { color: var(--muted); font-size: 13px; }
.cover .meta { display: flex; flex-wrap: wrap; gap: 8px 32px; color: var(--muted); font-size: 14px; }
.cover .meta b { color: var(--ink); font-weight: 600; }
details.edit { margin-top: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 12px 16px; }
details.edit summary { cursor: pointer; font-weight: 600; }
.form { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-top: 14px; }
.form label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--muted); }
.form input { border: 1px solid var(--line); background: var(--bg); border-radius: 4px; padding: 7px 9px; color: var(--ink); }

/* Nøkkeltall */
.kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
.kpi { background: var(--surface); padding: 16px 18px; }
.kpi .l { font-size: 13px; color: var(--muted); }
.kpi .v { font-size: 26px; font-weight: 600; margin-top: 2px; }
.kpi .k { font-size: 12px; margin-top: 6px; display: flex; gap: 6px; align-items: center; color: var(--muted); }
.st { display: inline-block; font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 3px; }
.st.ok { background: var(--ok-bg); color: var(--ok); }
.st.bad { background: var(--bad-bg); color: var(--bad); }
.st.warn { background: var(--warn-bg); color: var(--warn); }
.st.off { background: var(--surface2); color: var(--muted); }

/* Tabeller */
.tw { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); }
table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
th, td { padding: 7px 10px; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--line); }
th:first-child, td:first-child { text-align: left; }
td.l, th.l { text-align: left; }
thead th { background: var(--surface2); font-weight: 600; color: var(--ink); position: sticky; top: 0; }
tr.sum td { font-weight: 700; border-top: 2px solid var(--ink); }
tr.sub td { font-weight: 600; }
tr.passive td { color: var(--muted); }
tr.sel td { background: var(--surface2); }
td.ok { background: var(--ok-bg); color: var(--ok); font-weight: 600; }
td.bad { background: var(--bad-bg); color: var(--bad); font-weight: 600; }
td.cur, th.cur { box-shadow: inset 2px 0 0 var(--sand), inset -2px 0 0 var(--sand); }
tbody tr.click { cursor: pointer; }
tbody tr.click:hover td { background: var(--surface2); }

.grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
.card { background: var(--surface); border: 1px solid var(--line); padding: 16px 18px; }
.card h4 { margin: 0 0 10px; font-size: 14px; font-weight: 600; }
.chartbox { position: relative; height: 280px; }
.row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 0 0 16px; }
.row select { border: 1px solid var(--line); background: var(--surface); border-radius: 4px; padding: 7px 9px; min-width: 260px; }
.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px 24px; }
.facts div { font-size: 13px; color: var(--muted); }
.facts b { display: block; color: var(--ink); font-size: 16px; font-weight: 600; }
.checks { list-style: none; padding: 0; margin: 0; }
.checks li { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
.heat td.h { color: #13223B; }

@media (max-width: 900px) {
  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid2 { grid-template-columns: 1fr; }
  .cover .inner { padding: 32px 24px; }
  .cover .figs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  main { padding: 20px 14px 48px; }
  .topbar-inner, .files { padding-left: 14px; padding-right: 14px; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }

/* Utskrift */
@media print {
  @page { size: A4 landscape; margin: 12mm; }
  :root { --bg: #FFFFFF; }
  body { background: #FFFFFF; font-size: 11px; }
  body::before, .topbar, .tabs, details.edit, .noprint, .row select { display: none !important; }
  main { max-width: none; padding: 0; }
  .panel { display: block !important; break-before: page; }
  .panel:first-of-type { break-before: auto; }
  .panel[data-print="no"] { display: none !important; }
  .card, .tw, .kpis, .cover { break-inside: avoid; }
  .cover { min-height: 170mm; border: 0; }
  .chartbox { height: 220px; }
  thead th { position: static; }
  .tw { overflow: visible; }
  table { font-size: 10px; }
  th, td { padding: 4px 6px; }
}
</style>
</head>
<body>
<header class="topbar" id="topbar">
  <div class="topbar-inner">
    <div class="brand">Låneportefølje<small>presentasjon av lånemodell</small></div>
    <div class="ctrl noprint" id="yearCtrl" hidden><label for="year">År</label><select id="year"></select></div>
    <button class="btn primary" id="importBtn" type="button">Importer Excel-fil</button>
    <button class="btn" id="printBtn" type="button" hidden>Skriv ut / PDF</button>
    <input type="file" id="fileInput" accept=".xlsx,.xlsm" multiple hidden>
  </div>
  <div class="files" id="files"></div>
</header>
<nav class="tabs" id="tabs" hidden aria-label="Faner"><div class="tabs-inner" role="tablist" id="tablist"></div></nav>

<main>
  <section id="empty" class="empty">
    <h2>Importer lånemodellen</h2>
    <p class="lead">Velg Excel-filen fra lånemodellen for eiendomskonsern. Siden viser tallene som en presentasjon med faner. Importer flere filer, for eksempel Base og Hard stress, for å sammenligne scenarioer.</p>
    <div class="drop" id="drop">
      <p>Dra filen hit, eller velg den fra maskinen. Filen leses bare i nettleseren din og sendes ikke videre.</p>
      <div class="actions">
        <button class="btn2 primary" type="button" id="importBtn2">Importer Excel-fil</button>
        <button class="btn2" type="button" id="demoBtn">Vis med eksempeldata</button>
      </div>
      <div class="err" id="err" role="alert"></div>
    </div>
    <p class="note">Tallene vises slik de var sist filen ble lagret i Excel. Endre scenario eller forutsetninger i Excel, lagre, og importer filen på nytt.</p>
  </section>
  <div id="app" hidden></div>
</main>

<script>
/* Parser: leser lånemodellen (Excel) til et dataobjekt. Finner rader på radnavn i kolonne B. */
function parseModel(wb, XLSX) {
  const need = ["Forutsetninger", "Konsern", "Sensitivitet", "S01"];
  const missing = need.filter(n => !wb.Sheets[n]);
  if (missing.length) throw new Error("Filen mangler arkene: " + missing.join(", ") + ". Bruk lånemodellen for eiendomskonsern.");

  function rows(name) {
    const ws = wb.Sheets[name];
    if (!ws || !ws["!ref"]) return [];
    const rg = XLSX.utils.decode_range(ws["!ref"]);
    const out = [];
    for (let r = 0; r <= rg.e.r; r++) {
      const row = [];
      for (let c = 0; c <= 15; c++) {
        const cell = ws[XLSX.utils.encode_cell({ r, c })];
        row.push(cell ? cell.v : null);
      }
      out.push(row);
    }
    return out;
  }
  const lab = row => (row && typeof row[1] === "string") ? row[1].trim() : "";
  const num = v => (typeof v === "number" && isFinite(v)) ? v : (v === null || v === "" || v === undefined ? null : (isNaN(+v) ? null : +v));
  function find(R, label, opt = {}) {
    let start = 0;
    if (opt.after) {
      const a = R.findIndex(r => lab(r) === opt.after);
      start = a < 0 ? 0 : a + 1;
    }
    let n = opt.nth || 1;
    for (let i = start; i < R.length; i++) {
      if (opt.prefix ? lab(R[i]).startsWith(label) : lab(R[i]) === label) { if (--n === 0) return i; }
    }
    return -1;
  }
  const series = (R, i) => i < 0 ? Array(10).fill(null) : R[i].slice(3, 13).map(num);
  const ser = (R, label, opt) => series(R, find(R, label, opt));
  const cval = (R, label, col = 2, opt) => { const i = find(R, label, opt); return i < 0 ? null : R[i][col]; };
  const cnum = (R, label, col = 2, opt) => num(cval(R, label, col, opt));

  // Forutsetninger
  const F = rows("Forutsetninger");
  const yi = find(F, "År");
  const years = yi >= 0 ? F[yi].slice(3, 13).map(v => num(v)) : Array.from({ length: 10 }, (_, i) => 2026 + i);
  const scenRows = ["Base", "Moderat stress", "Hard stress"].map(s => {
    const i = find(F, s);
    return i < 0 ? null : { navn: s, rente: num(F[i][2]), ledighet: num(F[i][3]), yield: num(F[i][4]), kpi: num(F[i][5]) };
  }).filter(Boolean);
  const ai = find(F, "Aktive tillegg (scenario + manuell)");
  const fors = {
    startaar: cnum(F, "Første budsjettår"),
    scenario: cval(F, "Valgt scenario") || "",
    konsolidering: cval(F, "Konsolidering") || "",
    manRente: cnum(F, "Manuell renteendring (prosentpoeng, parallell)"),
    manLed: cnum(F, "Manuell ekstra ledighet (prosentpoeng)"),
    manYield: cnum(F, "Manuell yield-endring (prosentpoeng)"),
    scenarier: scenRows,
    tillegg: ai < 0 ? null : { rente: num(F[ai][2]), ledighet: num(F[ai][3]), yield: num(F[ai][4]), kpi: num(F[ai][5]) },
    niborBasis: ser(F, "3M NIBOR, basis (anslag)"),
    nibor: ser(F, "3M NIBOR, effektiv (inkl. scenario)"),
    kpiBasis: ser(F, "KPI, basis (anslag)"),
    kpi: ser(F, "KPI, effektiv (inkl. scenario)"),
    skatt: cnum(F, "Skattesats"),
    rentebegr: cval(F, "Anvend rentebegrensning (Ja/Nei)"),
    morAdm: cnum(F, "Administrasjonskostnader morselskap år 1 (TNOK, KPI-justert)"),
    morBank: cnum(F, "Bankinnskudd morselskap ved start (TNOK)"),
    krav: {
      ltv: cnum(F, "Maks belåningsgrad (LTV)"), icr: cnum(F, "Min. rentedekning (ICR)"),
      dscr: cnum(F, "Min. gjeldsbetjeningsevne (DSCR)"), dy: cnum(F, "Min. debt yield"),
      hg: cnum(F, "Min. sikringsgrad"), sd: cnum(F, "Min. sikkerhetsdekning")
    }
  };

  // Konsern
  const K = rows("Konsern");
  const kl = {
    pot: "Potensiell leie", ledt: "Ledighetstap", leie: "Leieinntekter", eierk: "Eierkostnader", noiDatter: "NOI datterselskaper",
    morAdm: "Administrasjonskostnader morselskap", noi: "NOI konsern", vedl: "Vedlikehold", skatt: "Betalt skatt", cfads: "CFADS konsern",
    renter: "Renter lån", swap: "Netto swapbetaling", avdrag: "Avdrag ordinært", etter: "Kontantstrøm etter ordinær gjeldsbetjening",
    innfr: "Innfrielse ved forfall", netto: "Netto kontantstrøm konsern", bank: "Bankinnskudd UB (inkl. mor)", gjeldIB: "Gjeld IB",
    gjeld: "Gjeld UB", flyt: "Gjeld med flytende rente", swapNot: "Swap hovedstol", eks: "Usikret flytende gjeld",
    rk: "Rentekostnad inkl. swap", effRente: "Effektiv rente etter swap", refi: "Refinansieringsbehov ved forfall",
    ikf: "Ikke fradragsberettiget rente", verdi: "Eiendomsverdi", pant: "Utnyttbar pantesikkerhet", ltv: "Belåningsgrad (LTV)",
    icr: "Rentedekning (ICR)", dscr: "Gjeldsbetjeningsevne (DSCR)", dy: "Debt yield", hg: "Sikringsgrad", sd: "Sikkerhetsdekning",
    brudd: "Covenantbrudd i datterselskaper (antall)", fAvd: "Ordinære avdrag"
  };
  const kons = {};
  for (const k in kl) kons[k] = ser(K, kl[k]);
  kons.fInnfr = ser(K, "Innfrielse ved forfall", { after: "Hjelperader for grafer" });
  kons.fRefi = ser(K, "Refinansiering ved forfall");
  kons.wault = cnum(K, "WAULT konsern år 1 (vektet på leie)");
  kons.garantier = cnum(K, "Garantier og andre sikkerheter");

  // Selskaper
  const selskaper = [];
  for (let n = 1; n <= 10; n++) {
    const name = "S" + String(n).padStart(2, "0");
    if (!wb.Sheets[name]) continue;
    const S = rows(name);
    const col = (label, c0, cn, opt) => { const i = find(S, label, opt); return i < 0 ? [] : S[i].slice(c0, cn + 1); };
    const lanParam = {
      navn: "Långiver / beskrivelse", status: "Status (Aktiv/Passiv)", type: "Lånetype (Annuitet/Serie/Stående)", saldo: "Saldo ved start (TNOK)",
      rentetype: "Rentetype (Flytende/Fast)", margin: "Margin over NIBOR", fastrente: "Fastrente", fastTil: "Fastrente til og med år nr",
      forfall: "Løpetid til forfall (år)", profil: "Avdragsprofil (år)", avdragsfri: "Avdragsfrie år", refi: "Refinansieres ved forfall (Ja/Nei)",
      refiMargin: "Refinansieringsmargin over NIBOR", pant: "Sikret i pant (henvisning)"
    };
    const lp = {}; for (const k in lanParam) lp[k] = col(lanParam[k], 2, 6);
    const lan = [];
    for (let i = 0; i < 5; i++) {
      const L = {}; for (const k in lanParam) L[k] = lp[k][i];
      const hi = find(S, `Lån ${i + 1}:`, { prefix: true });
      const after = l => { if (hi < 0) return Array(10).fill(null); for (let j = hi + 1; j < hi + 10; j++) if (lab(S[j]) === l) return series(S, j); return Array(10).fill(null); };
      L.ib = after("Inngående saldo"); L.rentesats = after("Rentesats"); L.rente = after("Rentekostnad"); L.avdrag = after("Avdrag ordinært");
      L.innfr = after("Innfrielse ved forfall"); L.refiBehov = after("Refinansieringsbehov ved forfall"); L.ub = after("Utgående saldo");
      L.saldo = num(L.saldo) || 0;
      lan.push(L);
    }
    const swParam = { status: "Status (Aktiv/Passiv)", hovedstol: "Hovedstol (TNOK)", fast: "Fast swaprente", start: "Startår nr", slutt: "Sluttår nr", ned: "Nedtrapping hovedstol per år (TNOK)" };
    const swp = {}; for (const k in swParam) swp[k] = col(swParam[k], 2, 4, { after: "Renteswapper – inndata (selskapet betaler fast, mottar NIBOR)" });
    const swaps = [0, 1, 2].map(i => { const o = {}; for (const k in swParam) o[k] = swp[k][i]; return o; });
    const ti = find(S, "Leietakere (største)");
    const leietakere = [];
    if (ti >= 0) for (let j = ti + 1; j <= ti + 5; j++) { const r = S[j]; if (r && r[1] && num(r[2])) leietakere.push({ navn: String(r[1]), leie: num(r[2]), aar: num(r[3]) }); }
    const pParam = { objekt: "Pantobjekt", dok: "Pantedokument, beløp (TNOK)", prioritet: "Prioritet", forans: "Foranstående heftelser (TNOK)", andel: "Andel av eiendomsverdien", hc: "Sikkerhetsverdi i % av markedsverdi", utnytt: "Utnyttbar sikkerhet år 1" };
    const pp = {}; for (const k in pParam) pp[k] = col(pParam[k], 2, 4);
    const pant = [0, 1, 2].map(i => { const o = {}; for (const k in pParam) o[k] = pp[k][i]; return o; }).filter(p => num(p.dok) > 0 || (p.objekt && String(p.objekt).trim()));
    const KS = "Kontantstrøm", NK = "Nøkkeltall og covenants", SL = "Sum lån (kun aktive lån)";
    selskaper.push({
      ark: name,
      navn: cval(S, "Selskapsnavn") || name,
      status: cval(S, "Status i konsern (Aktiv/Passiv)") || "Passiv",
      eierandel: cnum(S, "Eierandel"),
      eiendom: cval(S, "Eiendom / beskrivelse") || "",
      areal: cnum(S, "Areal (m²)"),
      faktor: cnum(S, "Faktor mot konsernnivå"),
      lan, swaps: swaps.filter(s => num(s.hovedstol) > 0),
      leie: {
        brutto: cnum(S, "Brutto kontraktsleie år 1 ved full utleie (TNOK)"), kpiAndel: cnum(S, "KPI-regulering av leie (andel)"),
        ledighet: cnum(S, "Ledighet, basis"), eierk: cnum(S, "Eierkostnader år 1 (TNOK, KPI-justeres)"), vedl: cnum(S, "Vedlikehold/oppgradering år 1 (TNOK, KPI-justeres)"),
        leietakere, wault: cnum(S, "WAULT (år)"), storste: cnum(S, "Største leietakers andel av kontraktsleie")
      },
      verdiMetode: cval(S, "Verdsettelsesmetode (Yield/Manuell)"), yieldBasis: cnum(S, "Avkastningskrav (yield), basis"),
      ser: {
        gjeldIB: ser(S, "Gjeld inngående", { after: SL }), renterLan: ser(S, "Rentekostnad lån", { after: SL }), avdrag: ser(S, "Avdrag ordinært", { after: SL }),
        innfr: ser(S, "Innfrielse ved forfall", { after: SL }), refi: ser(S, "Refinansieringsbehov ved forfall", { after: SL }), gjeld: ser(S, "Gjeld utgående", { after: SL }),
        flyt: ser(S, "Gjeld med flytende rente", { after: SL }), swapNot: ser(S, "Sum swap hovedstol"), swapNet: ser(S, "Sum netto swapbetaling"),
        rk: ser(S, "Rentekostnad inkl. swap"), effRente: ser(S, "Effektiv rente etter swap"), hg: ser(S, "Sikringsgrad (fastrente + swap) / gjeld"),
        eks: ser(S, "Usikret flytende gjeld (renteeksponering)"), ledighet: ser(S, "Ledighet (inkl. scenario)"),
        verdi: ser(S, "Eiendomsverdi", { after: "Eiendomsverdi" }), yieldEff: ser(S, "Yield inkl. scenario"),
        leie: ser(S, "Leieinntekter", { after: KS }), eierk: ser(S, "Eierkostnader", { after: KS }), noi: ser(S, "Netto driftsinntekt (NOI)", { after: KS }),
        vedl: ser(S, "Vedlikehold/oppgradering", { after: KS }), skatt: ser(S, "Betalt skatt", { after: KS }), cfads: ser(S, "Kontantstrøm før gjeldsbetjening (CFADS)"),
        renter: ser(S, "Renter lån", { after: KS }), swap: ser(S, "Netto swapbetaling", { after: KS }), avdragCF: ser(S, "Avdrag ordinært", { after: KS }),
        etter: ser(S, "Kontantstrøm etter ordinær gjeldsbetjening"), innfrCF: ser(S, "Innfrielse ved forfall (ikke refinansiert)"),
        netto: ser(S, "Netto kontantstrøm", { after: KS }), bank: ser(S, "Bankinnskudd UB", { after: KS }),
        ltv: ser(S, "Belåningsgrad (LTV)", { after: NK }), icr: ser(S, "Rentedekning (ICR) = NOI / rentekostnad"),
        dscr: ser(S, "Gjeldsbetjeningsevne (DSCR) = CFADS / (renter + avdrag)"), dy: ser(S, "Debt yield = NOI / gjeld"),
        brudd: ser(S, "Antall covenantbrudd"), pantSum: ser(S, "Utnyttbar pantesikkerhet"), sikgSum: ser(S, "Sikkerheter inkl. garantier"),
        sd: ser(S, "Sikkerhetsdekning (pant / gjeld)"), udekket: ser(S, "Udekket gjeld (gjeld – pant)")
      },
      pant,
      garanti: cnum(S, "Morselskapsgaranti / kausjon (TNOK)"), andreSik: cnum(S, "Andre sikkerheter (TNOK)"), andreSikTekst: cval(S, "Beskrivelse andre sikkerheter") || "",
      headroom: { verdi: cnum(S, "Verdifall før LTV-krav brytes"), rente: cnum(S, "Renteøkning før ICR-krav brytes (pp)"), ledighet: cnum(S, "Ekstra ledighet før DSCR-krav brytes (pp)") }
    });
  }

  // Sensitivitet
  const T = rows("Sensitivitet");
  function grid(prefix) {
    const i = find(T, prefix, { prefix: true });
    if (i < 0) return null;
    const head = T[i + 1].slice(3, 13).map(num);
    const body = [];
    for (let j = i + 2; j < i + 2 + 12 && j < T.length; j++) {
      const d = num(T[j][1]);
      if (d === null) break;
      body.push({ d, v: T[j].slice(3, 13).map(num) });
    }
    return { tittel: lab(T[i]), head, body };
  }
  const sens = { A: grid("A."), B: grid("B."), C: grid("C."), D: grid("D."), E: grid("E.") };
  const fi = find(T, "F.", { prefix: true });
  sens.F = fi < 0 ? null : { tittel: lab(T[fi]), head: T[fi + 1].slice(3, 10).map(num), verdi: T[fi + 2].slice(3, 10).map(num), ltv: T[fi + 3].slice(3, 10).map(num) };
  const gi = find(T, "G.", { prefix: true });
  sens.G = [];
  if (gi >= 0) for (let j = gi + 2; j < T.length; j++) { const l = lab(T[j]); if (!l || T[j][2] === null) break; sens.G.push({ navn: l, verdi: num(T[j][2]) }); }

  // Kontroller (Dashboard)
  const D = rows("Dashboard");
  const kontroller = [];
  const ci = find(D, "Kontroller");
  if (ci >= 0) for (let j = ci + 1; j < ci + 10; j++) { const l = lab(D[j]); if (!l) break; kontroller.push({ navn: l, antall: num(D[j][2]), status: D[j][3] }); }

  // Sjekk at verdier er beregnet (Excel har lagret resultater)
  const hasVals = kons.gjeld.some(v => v !== null);
  if (!hasVals) throw new Error("Filen inneholder ikke beregnede verdier. Åpne den i Excel, trykk lagre, og importer på nytt.");

  return { years, fors, kons, selskaper, sens, kontroller };
}
if (typeof module !== "undefined") module.exports = { parseModel };

</script>
<script>
const DEMO = { base: "", hard: "" };
(function () {
  "use strict";
  const $ = s => document.querySelector(s);
  const state = { files: [], active: 0, year: 0, tab: "forside", company: 0,
    cover: { kunde: "Kundenavn AS", tittel: "Finansieringsanalyse – låneportefølje", av: "", dato: new Date().toLocaleDateString("nb-NO", { day: "numeric", month: "long", year: "numeric" }), logo: "" } };
  const charts = [];
  const TABS = [["forside", "Forside"], ["oversikt", "Oversikt"], ["konsern", "Konsern"], ["selskaper", "Selskaper"], ["lan", "Lån og forfall"],
    ["stress", "Rente og stress"], ["sikkerheter", "Sikkerheter"], ["forutsetninger", "Forutsetninger"], ["sammenligning", "Sammenligning"]];

  /* ---------- formatering ---------- */
  const nf = new Intl.NumberFormat("nb-NO", { maximumFractionDigits: 0 });
  const isNum = v => typeof v === "number" && isFinite(v);
  const minus = s => s.replace("-", "−");
  const f = {
    n: v => !isNum(v) || Math.abs(v) < 0.5 ? "–" : minus(nf.format(Math.round(v))),
    m: v => !isNum(v) || Math.abs(v) < 50 ? "–" : minus((v / 1000).toLocaleString("nb-NO", { minimumFractionDigits: 1, maximumFractionDigits: 1 })),
    p: (v, d = 1) => !isNum(v) ? "–" : minus((v * 100).toLocaleString("nb-NO", { minimumFractionDigits: d, maximumFractionDigits: d }) + " %"),
    pp: (v, d = 2) => !isNum(v) ? "–" : minus(((v >= 0 ? "+" : "") + (v * 100).toLocaleString("nb-NO", { minimumFractionDigits: d, maximumFractionDigits: d })) + " pp"),
    x: v => !isNum(v) || v === 0 ? "–" : minus(v.toLocaleString("nb-NO", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "x"),
    y: v => !isNum(v) || v === 0 ? "–" : v.toLocaleString("nb-NO", { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + " år"
  };
  const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();

  /* ---------- import ---------- */
  function readFile(file) {
    return new Promise((res, rej) => {
      const r = new FileReader();
      r.onload = () => res(r.result);
      r.onerror = () => rej(new Error("Kunne ikke lese filen " + file.name + "."));
      r.readAsArrayBuffer(file);
    });
  }
  function addModel(name, buf) {
    const wb = XLSX.read(buf, { type: "array" });
    const data = parseModel(wb, XLSX);
    const label = name.replace(/\.(xlsx|xlsm)$/i, "");
    const i = state.files.findIndex(x => x.name === label);
    const entry = { name: label, data };
    if (i >= 0) state.files[i] = entry; else state.files.push(entry);
    state.active = i >= 0 ? i : state.files.length - 1;
  }
  async function importFiles(list) {
    const errs = [];
    for (const file of list) {
      try { addModel(file.name, await readFile(file)); }
      catch (e) { errs.push(file.name + ": " + e.message); }
    }
    showError(errs.join(" "));
    if (state.files.length) render();
  }
  function showError(msg) {
    const e = $("#err");
    e.textContent = msg; e.classList.toggle("show", !!msg);
    if (msg && state.files.length) alert(msg);
  }
  function b64ToBuf(b64) { const s = atob(b64); const a = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) a[i] = s.charCodeAt(i); return a.buffer; }
  function loadDemo() {
    try {
      addModel("Eksempel – Base.xlsx", b64ToBuf(DEMO.base));
      addModel("Eksempel – Hard stress.xlsx", b64ToBuf(DEMO.hard));
      state.active = 0; state.cover.kunde = "Eksempel Eiendom Holding AS";
      render();
    } catch (e) { showError(e.message); }
  }
  $("#importBtn").onclick = () => $("#fileInput").click();
  $("#importBtn2").onclick = () => $("#fileInput").click();
  $("#demoBtn").onclick = loadDemo;
  $("#fileInput").onchange = e => { importFiles([...e.target.files]); e.target.value = ""; };
  const drop = $("#drop");
  ["dragenter", "dragover"].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add("over"); }));
  ["dragleave", "drop"].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove("over"); }));
  drop.addEventListener("drop", e => importFiles([...e.dataTransfer.files]));
  $("#printBtn").onclick = () => { try { window.print(); } catch (e) { alert("Bruk Ctrl+P (Cmd+P på Mac) for å skrive ut eller lagre som PDF."); } };
  $("#year").onchange = e => { state.year = +e.target.value; render(); };

  /* ---------- hjelpere ---------- */
  const D = () => state.files[state.active].data;
  const Y = () => state.year;
  const yr = i => D().years[i];
  function status(v, krav, dir) {
    if (!isNum(v) || !isNum(krav) || v === 0) return '<span class="st off">–</span>';
    const ok = dir === "max" ? v <= krav : v >= krav;
    return ok ? '<span class="st ok">OK</span>' : '<span class="st bad">Brudd</span>';
  }
  function cellCls(v, krav, dir) {
    if (!isNum(v) || !isNum(krav) || v === 0) return "";
    return (dir === "max" ? v <= krav : v >= krav) ? "ok" : "bad";
  }
  const yearHead = (first = "TNOK") => `<thead><tr><th class="l">${first}</th>${D().years.map((y, i) => `<th class="${i === Y() ? "cur" : ""}">${y}</th>`).join("")}</tr></thead>`;
  const serRow = (label, arr, fmt = f.n, cls = "", tdCls = null) =>
    `<tr class="${cls}"><td class="l">${esc(label)}</td>${arr.map((v, i) => `<td class="${[i === Y() ? "cur" : "", tdCls ? tdCls(v) : ""].join(" ")}">${fmt(v)}</td>`).join("")}</tr>`;
  const table = (head, body) => `<div class="tw"><table>${head}<tbody>${body}</tbody></table></div>`;
  const neg = a => a.map(v => isNum(v) ? -v : v);

  function chart(id, type, labels, datasets, opts = {}) {
    const el = document.getElementById(id);
    if (!el) return;
    const ink = css("--muted"), grid = css("--line");
    const c = new Chart(el, {
      type, data: { labels, datasets },
      options: Object.assign({
        responsive: true, maintainAspectRatio: false, animation: false,
        interaction: { mode: "index", intersect: false },
        plugins: { legend: { position: "bottom", labels: { color: ink, boxWidth: 12, font: { family: "Public Sans", size: 12 } } },
          tooltip: { callbacks: { label: ctx => " " + ctx.dataset.label + ": " + (opts.fmt || f.n)(ctx.parsed.y ?? ctx.parsed.x) } } },
        scales: {
          x: { stacked: !!opts.stacked, ticks: { color: ink }, grid: { color: grid, display: false } },
          y: { stacked: !!opts.stacked, ticks: { color: ink, callback: v => (opts.axis || opts.fmt || f.n)(v) }, grid: { color: grid }, beginAtZero: opts.zero !== false }
        }
      }, opts.chart || {})
    });
    charts.push(c);
  }
  const ds = (label, data, color, extra = {}) => Object.assign({ label, data, backgroundColor: color, borderColor: color, borderWidth: 2, pointRadius: 2, tension: 0.15 }, extra);

  /* ---------- render ---------- */
  function render() {
    charts.splice(0).forEach(c => c.destroy());
    const has = state.files.length > 0;
    $("#empty").hidden = has; $("#app").hidden = !has; $("#tabs").hidden = !has;
    $("#yearCtrl").hidden = !has; $("#printBtn").hidden = !has;
    renderFiles();
    if (!has) return;
    document.documentElement.style.setProperty("--topbar-h", $("#topbar").offsetHeight + "px");
    const ys = D().years;
    $("#year").innerHTML = ys.map((y, i) => `<option value="${i}" ${i === Y() ? "selected" : ""}>${y}</option>`).join("");
    const multi = state.files.length > 1;
    const tabs = TABS.filter(t => t[0] !== "sammenligning" || multi);
    if (!tabs.find(t => t[0] === state.tab)) state.tab = "forside";
    $("#tablist").innerHTML = tabs.map(([id, n]) => `<button class="tab" role="tab" aria-selected="${id === state.tab}" data-tab="${id}">${n}</button>`).join("");
    $("#tablist").querySelectorAll(".tab").forEach(b => b.onclick = () => setTab(b.dataset.tab));
    $("#app").innerHTML = tabs.map(([id]) => `<section class="panel ${id === state.tab ? "active" : ""}" id="p-${id}" data-print="${id === "sammenligning" && !multi ? "no" : "yes"}"></section>`).join("");
    pForside(); pOversikt(); pKonsern(); pSelskaper(); pLan(); pStress(); pSikkerheter(); pForutsetninger(); if (multi) pSammenligning();
  }
  function setTab(id) {
    state.tab = id;
    document.querySelectorAll(".tab").forEach(b => b.setAttribute("aria-selected", b.dataset.tab === id));
    document.querySelectorAll(".panel").forEach(p => p.classList.toggle("active", p.id === "p-" + id));
    if (location.hash !== "#" + id) history.replaceState(null, "", "#" + id);
    charts.forEach(c => c.resize());
    window.scrollTo({ top: 0 });
  }
  window.addEventListener("hashchange", () => { const h = location.hash.slice(1); if (TABS.some(t => t[0] === h) && state.files.length) setTab(h); });
  function renderFiles() {
    $("#files").innerHTML = state.files.map((x, i) =>
      `<span class="chip ${i === state.active ? "active" : ""}" data-i="${i}" title="Vis denne filen">${esc(x.name)}<span class="ref">${esc(x.data.fors.scenario)}${i === 0 && state.files.length > 1 ? ", referanse" : ""}</span><button class="x" data-x="${i}" aria-label="Fjern ${esc(x.name)}">×</button></span>`).join("");
    $("#files").querySelectorAll(".chip").forEach(c => c.onclick = e => {
      if (e.target.dataset.x !== undefined) { state.files.splice(+e.target.dataset.x, 1); state.active = Math.min(state.active, state.files.length - 1); state.active = Math.max(0, state.active); render(); return; }
      state.active = +c.dataset.i; render();
    });
  }

  /* ---------- Forside ---------- */
  function pForside() {
    const d = D(), k = d.kons, i = Y(), c = state.cover;
    const aktive = d.selskaper.filter(s => s.status === "Aktiv").length;
    const lan = d.selskaper.filter(s => s.status === "Aktiv").reduce((a, s) => a + s.lan.filter(l => l.status === "Aktiv" && l.saldo > 0).length, 0);
    $("#p-forside").innerHTML = `
      <div class="cover">
        <div class="rule"></div>
        <div class="inner">
          <div class="top">
            <div class="doc">${esc(c.dato)}</div>
            ${c.logo ? `<img class="logo" src="${c.logo}" alt="Logo">` : ""}
          </div>
          <div>
            <p class="customer">${esc(c.kunde)}</p>
            <p class="title">${esc(c.tittel)}</p>
          </div>
          <div><span class="stamp">Scenario: ${esc(d.fors.scenario)}</span></div>
          <div class="meta">
            <span>Konsern med <b>${aktive}</b> aktive selskaper og <b>${lan}</b> aktive lån</span>
            <span>Periode <b>${d.years[0]}–${d.years[9]}</b></span>
            <span>Konsolidering <b>${esc(d.fors.konsolidering)}</b></span>
            ${c.av ? `<span>Utarbeidet av <b>${esc(c.av)}</b></span>` : ""}
          </div>
          <div class="figs">
            <div><div class="v">${f.m(k.gjeld[i])} MNOK</div><div class="l">Gjeld ${yr(i)}</div></div>
            <div><div class="v">${f.m(k.verdi[i])} MNOK</div><div class="l">Eiendomsverdi ${yr(i)}</div></div>
            <div><div class="v">${f.p(k.ltv[i])}</div><div class="l">Belåningsgrad</div></div>
            <div><div class="v">${f.x(k.icr[i])}</div><div class="l">Rentedekning</div></div>
          </div>
        </div>
      </div>
      <details class="edit noprint">
        <summary>Rediger forside</summary>
        <div class="form">
          <label>Kundenavn<input id="cvKunde" value="${esc(c.kunde)}"></label>
          <label>Tittel<input id="cvTittel" value="${esc(c.tittel)}"></label>
          <label>Utarbeidet av<input id="cvAv" value="${esc(c.av)}" placeholder="Navn, avdeling"></label>
          <label>Dato<input id="cvDato" value="${esc(c.dato)}"></label>
          <label>Logo (PNG, JPG eller SVG)<input id="cvLogo" type="file" accept="image/*"></label>
        </div>
        <p class="note">Forsiden lagres ikke. Logoen leses lokalt og sendes ikke videre.</p>
      </details>`;
    const bind = (id, key) => $(id).onchange = e => { c[key] = e.target.value; const open = true; render(); setTab("forside"); document.querySelector("details.edit").open = open; };
    bind("#cvKunde", "kunde"); bind("#cvTittel", "tittel"); bind("#cvAv", "av"); bind("#cvDato", "dato");
    $("#cvLogo").onchange = e => {
      const file = e.target.files[0]; if (!file) return;
      const r = new FileReader(); r.onload = () => { c.logo = r.result; render(); setTab("forside"); document.querySelector("details.edit").open = true; }; r.readAsDataURL(file);
    };
  }

  /* ---------- Oversikt ---------- */
  function pOversikt() {
    const d = D(), k = d.kons, i = Y(), kr = d.fors.krav;
    const kpi = (l, v, fmt, krav, dir) => `<div class="kpi"><div class="l">${l}</div><div class="v">${fmt(v)}</div>${krav !== undefined ? `<div class="k">${status(v, krav, dir)}<span>Krav ${dir === "max" ? "maks" : "min"} ${fmt === f.p ? f.p(krav, 0) : fmt(krav)}</span></div>` : '<div class="k">&nbsp;</div>'}</div>`;
    const brudd = k.brudd[i] || 0;
    const covRows = [["Belåningsgrad (LTV)", k.ltv, f.p, kr.ltv, "max"], ["Rentedekning (ICR)", k.icr, f.x, kr.icr, "min"], ["Gjeldsbetjeningsevne (DSCR)", k.dscr, f.x, kr.dscr, "min"],
      ["Debt yield", k.dy, f.p, kr.dy, "min"], ["Sikringsgrad", k.hg, f.p, kr.hg, "min"], ["Sikkerhetsdekning", k.sd, f.x, kr.sd, "min"]];
    $("#p-oversikt").innerHTML = `
      <h2>Oversikt ${yr(i)}</h2>
