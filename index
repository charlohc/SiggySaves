      + (lanAkt.map(l => `<tr class="${l.status !== "Aktiv" ? "passive" : ""}"><td class="l">${esc(l.navn)}</td><td class="l"><span class="st ${l.status === "Aktiv" ? "ok" : "off"}">${esc(l.status)}</span></td><td class="l">${esc(l.type)}</td>
        <td>${f.n(l.saldo)}</td><td class="l">${l.rentetype === "Fast" ? "Fast " + f.p(l.fastrente, 2) + " til år " + l.fastTil : "NIBOR + " + f.p(l.margin, 2)}</td><td>${l.forfall ?? "–"}</td><td>${l.type === "Stående" ? "–" : (l.profil ?? "–")}</td>
        <td class="l">${esc(l.refi)}</td><td>${f.n(l.ub[i])}</td><td class="l">${esc(l.pant)}</td></tr>`).join("") || `<tr><td class="l" colspan="10">Ingen lån registrert.</td></tr>`) + "</tbody>";
    const swTbl = s.swaps.length ? table(`<thead><tr><th class="l">Swap</th><th class="l">Status</th><th>Hovedstol</th><th>Fast rente</th><th>Periode</th><th>Nedtrapping/år</th></tr></thead>`,
      s.swaps.map((w, j) => `<tr class="${w.status !== "Aktiv" ? "passive" : ""}"><td class="l">Swap ${j + 1}</td><td class="l"><span class="st ${w.status === "Aktiv" ? "ok" : "off"}">${esc(w.status)}</span></td><td>${f.n(w.hovedstol)}</td><td>${f.p(w.fast, 2)}</td><td>År ${w.start}–${w.slutt}</td><td>${f.n(w.ned)}</td></tr>`).join("")) : '<p class="note">Ingen swapper registrert.</p>';
    const S = s.ser;
    $("#p-selskaper").innerHTML = `
      <h2>Selskaper</h2>
      <p class="lead">Klikk på et selskap for detaljer. Passive selskaper er beregnet, men holdes utenfor konsernet.</p>
      <div class="tw"><table>${tbl}</table></div>
      <h3 style="margin-top:36px">${esc(s.navn)}</h3>
      <div class="row noprint"><select id="coSel" aria-label="Velg selskap">${list.map((x, j) => `<option value="${j}" ${j === state.company ? "selected" : ""}>${esc(x.navn)}</option>`).join("")}</select></div>
      <div class="card"><div class="facts">
        <div>Status<b>${esc(s.status)}</b></div><div>Eiendom<b>${esc(s.eiendom || "–")}</b></div><div>Areal<b>${s.areal ? f.n(s.areal) + " m²" : "–"}</b></div>
        <div>Eierandel<b>${f.p(s.eierandel, 0)}</b></div><div>Kontraktsleie år 1<b>${f.n(s.leie.brutto)} TNOK</b></div><div>Ledighet basis<b>${f.p(s.leie.ledighet)}</b></div>
        <div>Verdsettelse<b>${esc(s.verdiMetode)}, yield ${f.p(s.yieldBasis, 2)}</b></div><div>Største leietaker<b>${f.p(s.leie.storste)}</b></div>
        <div>Headroom verdifall<b>${f.p(s.headroom.verdi)}</b></div><div>Headroom rente (ICR)<b>${isNum(s.headroom.rente) && s.headroom.rente !== 0 ? f.pp(s.headroom.rente) : "–"}</b></div>
      </div></div>
      <h3>Lån</h3><div class="tw"><table>${lanTbl}</table></div>
      <h3>Swapper</h3>${swTbl}
      <h3>Kontantstrøm og nøkkeltall (TNOK)</h3>
      ${table(yearHead(), [serRow("Leieinntekter", S.leie), serRow("Eierkostnader", S.eierk), serRow("NOI", S.noi, f.n, "sub"), serRow("Vedlikehold", S.vedl), serRow("Betalt skatt", S.skatt),
        serRow("CFADS", S.cfads, f.n, "sub"), serRow("Renter lån", S.renter), serRow("Netto swap", S.swap), serRow("Avdrag", S.avdragCF), serRow("Innfrielse ved forfall", S.innfrCF),
        serRow("Netto kontantstrøm", S.netto, f.n, "sum"), serRow("Bankinnskudd", S.bank, f.n, "", v => v < 0 ? "bad" : ""), serRow("Gjeld ved årsslutt", S.gjeld, f.n, "sub"), serRow("Eiendomsverdi", S.verdi),
        serRow("LTV", S.ltv, f.p, "", v => cellCls(v, kr.ltv, "max")), serRow("ICR", S.icr, f.x, "", v => cellCls(v, kr.icr, "min")), serRow("DSCR", S.dscr, f.x, "", v => cellCls(v, kr.dscr, "min")),
        serRow("Sikringsgrad", S.hg, f.p), serRow("Effektiv rente", S.effRente, v => f.p(v, 2))].join(""))}
      <div class="grid2" style="margin-top:20px">
        <div class="card"><h4>Gjeld per lån (TNOK)</h4><div class="chartbox"><canvas id="ch-s1"></canvas></div></div>
        <div class="card"><h4>NOI og gjeldsbetjening (TNOK)</h4><div class="chartbox"><canvas id="ch-s2"></canvas></div></div>
      </div>`;
