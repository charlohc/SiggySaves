    const cols = ["--c1", "--c2", "--c3", "--c4", "--c5"];
    chart("ch-s1", "bar", d.years, s.lan.filter(l => l.status === "Aktiv" && l.saldo > 0).map((l, j) => ds(l.navn, l.ub, css(cols[j % 5]))), { stacked: true });
    chart("ch-s2", "bar", d.years, [ds("NOI", S.noi, css("--c1")), ds("Renter inkl. swap", S.rk, css("--c3")), ds("Avdrag", S.avdrag, css("--c4"))]);
  }

  /* ---------- Lån og forfall ---------- */
  function pLan() {
    const d = D(), i = Y(), k = d.kons;
    const all = [];
    d.selskaper.forEach(s => s.lan.forEach(l => { if (l.saldo > 0) all.push({ s, l }); }));
    const aktiv = x => x.s.status === "Aktiv" && x.l.status === "Aktiv";
    const tot = all.filter(aktiv).reduce((a, x) => a + (x.l.ub[i] || 0), 0);
    const rows = all.map(x => `<tr class="${aktiv(x) ? "" : "passive"}"><td class="l">${esc(x.s.navn)}</td><td class="l">${esc(x.l.navn)}</td><td class="l"><span class="st ${aktiv(x) ? "ok" : "off"}">${aktiv(x) ? "Med" : "Utenfor"}</span></td>
      <td class="l">${esc(x.l.type)}</td><td class="l">${x.l.rentetype === "Fast" ? "Fast " + f.p(x.l.fastrente, 2) : "NIBOR + " + f.p(x.l.margin, 2)}</td><td>${f.n(x.l.saldo)}</td>
      <td>${isNum(x.l.forfall) ? yr(0) + x.l.forfall - 1 : "–"}</td><td class="l">${esc(x.l.refi)}</td><td>${f.n(x.l.ub[i])}</td><td>${f.p(x.l.rentesats[i], 2)}</td></tr>`).join("");
    const swaps = [];
    d.selskaper.forEach(s => s.swaps.forEach((w, j) => swaps.push({ s, w, j })));
    $("#p-lan").innerHTML = `
      <h2>Lån og forfall</h2>
      <p class="lead">${all.filter(aktiv).length} aktive lån med samlet saldo ${f.n(tot)} TNOK ved utgangen av ${yr(i)}. Største refinansieringsår er ${(() => { const m = Math.max(...k.fRefi.map(v => v || 0)); return m > 0 ? yr(k.fRefi.indexOf(m)) + " med " + f.n(m) + " TNOK" : "ikke i perioden"; })()}.</p>
      <div class="tw"><table><thead><tr><th class="l">Selskap</th><th class="l">Lån</th><th class="l">I konsern</th><th class="l">Type</th><th class="l">Rentebasis</th><th>Saldo start</th><th>Forfallsår</th><th class="l">Refinansieres</th><th>Saldo ${yr(i)}</th><th>Rente ${yr(i)}</th></tr></thead><tbody>${rows}
        <tr class="sum"><td class="l">Sum aktive lån</td><td></td><td></td><td></td><td></td><td>${f.n(all.filter(aktiv).reduce((a, x) => a + x.l.saldo, 0))}</td><td></td><td></td><td>${f.n(tot)}</td><td>${f.p(k.effRente[i], 2)}</td></tr></tbody></table></div>
      <div class="grid2" style="margin-top:20px">
        <div class="card"><h4>Forfallsprofil (TNOK)</h4><div class="chartbox"><canvas id="ch-l1"></canvas></div><p class="note">Refinansiering er restsaldo ved forfall som videreføres. Innfrielse må betales.</p></div>
        <div class="card"><h4>Sikringsgrad og effektiv rente</h4><div class="chartbox"><canvas id="ch-l2"></canvas></div></div>
      </div>
      <h3>Renteswapper</h3>
      ${swaps.length ? `<div class="tw"><table><thead><tr><th class="l">Selskap</th><th class="l">Swap</th><th class="l">Status</th><th>Hovedstol</th><th>Fast rente</th><th>Periode</th></tr></thead><tbody>${swaps.map(x =>
        `<tr class="${x.s.status === "Aktiv" && x.w.status === "Aktiv" ? "" : "passive"}"><td class="l">${esc(x.s.navn)}</td><td class="l">Swap ${x.j + 1}</td><td class="l">${esc(x.w.status)}</td><td>${f.n(x.w.hovedstol)}</td><td>${f.p(x.w.fast, 2)}</td><td>${yr(0) + x.w.start - 1}–${yr(0) + x.w.slutt - 1}</td></tr>`).join("")}</tbody></table></div>` : '<p class="note">Ingen swapper i porteføljen.</p>'}`;
    chart("ch-l1", "bar", d.years, [ds("Ordinære avdrag", k.fAvd, css("--c1")), ds("Innfrielse", k.fInnfr, css("--c6")), ds("Refinansiering", k.fRefi, css("--c3"))], { stacked: true });
    chart("ch-l2", "line", d.years, [ds("Sikringsgrad", k.hg, css("--c1")), ds("Effektiv rente", k.effRente, css("--c3")), ds("Krav sikringsgrad", d.years.map(() => d.fors.krav.hg), css("--c1"), { borderDash: [5, 4], pointRadius: 0, borderWidth: 1.5 })], { fmt: v => f.p(v, 1) });
  }

  /* ---------- Rente og stress ---------- */
  function heat(g, fmt, krav, dir, colHead) {
    if (!g) return "";
    const head = `<thead><tr><th class="l">${colHead ? "Rente \\ " + colHead : "Renteendring"}</th>${g.head.filter(isNum).map(h => `<th>${colHead ? f.p(h) : h}</th>`).join("")}</tr></thead>`;
    const body = g.body.map(r => `<tr><td class="l">${f.pp(r.d)}</td>${r.v.slice(0, g.head.filter(isNum).length).map(v => `<td class="${krav === null ? (v < 0 ? "bad" : "") : cellCls(v, krav, dir)}">${fmt(v)}</td>`).join("")}</tr>`).join("");
    return `<div class="tw heat"><table>${head}<tbody>${body}</tbody></table></div>`;
  }
  function pStress() {
    const d = D(), s = d.sens, kr = d.fors.krav;
    $("#p-stress").innerHTML = `
      <h2>Rente og stress</h2>
      <p class="lead">Effekt av renteendring oppå scenario ${esc(d.fors.scenario)}. Renteendringen treffer bare gjeld som ikke er sikret med fastrente eller swap. Grønt er innenfor krav, rødt er brudd.</p>
      <div class="kpis">${s.G.slice(0, 4).map(g => `<div class="kpi"><div class="l">${esc(g.navn)}</div><div class="v">${g.navn.includes("ledighet") ? f.pp(g.verdi, 1) : f.pp(g.verdi)}</div></div>`).join("")}</div>
      <h3>Rentedekning (ICR) per år ved renteendring</h3>${heat(s.B, f.x, kr.icr, "min")}
      <h3>Gjeldsbetjeningsevne (DSCR) per år ved renteendring</h3>${heat(s.C, f.x, kr.dscr, "min")}
      <h3>Kontantstrøm etter gjeldsbetjening (TNOK)</h3>${heat(s.D, f.n, null)}
      <h3>ICR ${yr(0)}: renteendring og ekstra ledighet</h3>${heat(s.E, f.x, kr.icr, "min", "Ledighet")}
      <div class="grid2" style="margin-top:20px">
        <div class="card"><h4>Belåningsgrad ${yr(0)} ved endret yield</h4><div class="chartbox"><canvas id="ch-t1"></canvas></div></div>
        <div class="card"><h4>Rentekostnad ved renteendring (TNOK)</h4><div class="chartbox"><canvas id="ch-t2"></canvas></div></div>
      </div>
      <h3>Break-even og headroom ${yr(0)}</h3>
      <div class="card"><ul class="checks">${s.G.map(g => `<li><span>${esc(g.navn)}</span><b>${g.navn.includes("TNOK") ? f.n(g.verdi) + " TNOK" : g.navn.startsWith("Verdifall") ? f.p(g.verdi) : g.navn.includes("ledighet") ? f.pp(g.verdi, 1) : f.pp(g.verdi)}</b></li>`).join("")}</ul>
      <p class="note">Negativ verdi betyr at kravet allerede er brutt.</p></div>`;
    if (s.F) chart("ch-t1", "bar", s.F.head.map(h => f.pp(h)), [ds("LTV", s.F.ltv, s.F.ltv.map(v => v > kr.ltv ? css("--c6") : css("--c1"))),
      Object.assign(ds("Krav", s.F.head.map(() => kr.ltv), css("--c3"), { pointRadius: 0, borderDash: [5, 4] }), { type: "line" })], { fmt: v => f.p(v, 0) });
    if (s.A) chart("ch-t2", "line", d.years, s.A.body.filter((r, j) => [2, 4, 6].includes(j)).map((r, j) => ds(r.d === 0 ? "Ingen endring" : f.pp(r.d, 0), r.v, css(["--c1", "--c3", "--c6"][j]))));
  }

  /* ---------- Sikkerheter ---------- */
  function pSikkerheter() {
    const d = D(), i = Y(), kr = d.fors.krav;
    const rows = [];
    d.selskaper.forEach(s => {
      const akt = s.status === "Aktiv";
      if (!s.pant.length && !(s.ser.gjeld[i] > 0)) return;
      s.pant.forEach((p, j) => rows.push(`<tr class="${akt ? "" : "passive"}"><td class="l">${j === 0 ? esc(s.navn) : ""}</td><td class="l">${esc(p.objekt)}</td><td>${p.prioritet ?? "–"}</td><td>${f.n(p.dok)}</td><td>${f.n(p.forans)}</td><td>${f.p(p.hc, 0)}</td><td>${f.n(p.utnytt)}</td><td></td><td></td></tr>`));
      rows.push(`<tr class="sub ${akt ? "" : "passive"}"><td class="l">${s.pant.length ? "" : esc(s.navn)}</td><td class="l">Sum ${esc(s.navn)}${s.garanti || s.andreSik ? `, garantier ${f.n((s.garanti || 0) + (s.andreSik || 0))}` : ""}</td><td></td><td></td><td></td><td></td><td>${f.n(s.ser.pantSum[i])}</td><td>${f.n(s.ser.gjeld[i])}</td><td class="${akt ? cellCls(s.ser.sd[i], kr.sd, "min") : ""}">${f.x(s.ser.sd[i])}</td></tr>`);
    });
    $("#p-sikkerheter").innerHTML = `
      <h2>Sikkerheter</h2>
      <p class="lead">Utnyttbar pantesikkerhet er ${f.n(d.kons.pant[i])} TNOK mot gjeld på ${f.n(d.kons.gjeld[i])} TNOK, en sikkerhetsdekning på ${f.x(d.kons.sd[i])}. I tillegg kommer garantier på ${f.n(d.kons.garantier)} TNOK.</p>
      <div class="tw"><table><thead><tr><th class="l">Selskap</th><th class="l">Pantobjekt</th><th>Prioritet</th><th>Pantedokument</th><th>Foranstående</th><th>Sikkerhetsverdi</th><th>Utnyttbar ${yr(i)}</th><th>Gjeld ${yr(i)}</th><th>Dekning</th></tr></thead>
      <tbody>${rows.join("")}<tr class="sum"><td class="l">Konsern (aktive)</td><td></td><td></td><td></td><td></td><td></td><td>${f.n(d.kons.pant[i])}</td><td>${f.n(d.kons.gjeld[i])}</td><td>${f.x(d.kons.sd[i])}</td></tr></tbody></table></div>
      <p class="note">Utnyttbar sikkerhet er det laveste av pantedokumentet og eiendomsverdien × sikkerhetsverdi-andel, fratrukket foranstående heftelser.</p>
      <div class="card" style="margin-top:20px"><h4>Pantesikkerhet mot gjeld (TNOK)</h4><div class="chartbox"><canvas id="ch-p1"></canvas></div></div>`;
    chart("ch-p1", "line", d.years, [ds("Utnyttbar pant", d.kons.pant, css("--c3")), ds("Gjeld", d.kons.gjeld, css("--c1")), ds("Eiendomsverdi", d.kons.verdi, css("--c4"))]);
  }

  /* ---------- Forutsetninger ---------- */
  function pForutsetninger() {
    const d = D(), F = d.fors, kr = F.krav, t = F.tillegg || {};
    $("#p-forutsetninger").innerHTML = `
      <h2>Forutsetninger</h2>
      <p class="lead">Scenario ${esc(F.scenario)} legger til ${f.pp(t.rente)} på renten, ${f.pp(t.ledighet, 1)} på ledigheten og ${f.pp(t.yield)} på yield, inkludert manuelle justeringer.</p>
      <div class="grid2">
        <div class="card"><h4>Rentebane og KPI</h4><div class="chartbox"><canvas id="ch-f1"></canvas></div></div>
        <div class="card"><h4>Bankens krav</h4><ul class="checks">
          <li><span>Maks belåningsgrad (LTV)</span><b>${f.p(kr.ltv, 0)}</b></li><li><span>Min. rentedekning (ICR)</span><b>${f.x(kr.icr)}</b></li>
          <li><span>Min. gjeldsbetjeningsevne (DSCR)</span><b>${f.x(kr.dscr)}</b></li><li><span>Min. debt yield</span><b>${f.p(kr.dy)}</b></li>
          <li><span>Min. sikringsgrad</span><b>${f.p(kr.hg, 0)}</b></li><li><span>Min. sikkerhetsdekning</span><b>${f.x(kr.sd)}</b></li></ul></div>
      </div>
      <h3>Rente- og KPI-bane</h3>
      ${table(yearHead("Prosent"), [serRow("3M NIBOR, basis", F.niborBasis, v => f.p(v, 2)), serRow("3M NIBOR, i scenario", F.nibor, v => f.p(v, 2), "sub"), serRow("KPI, basis", F.kpiBasis, f.p), serRow("KPI, i scenario", F.kpi, f.p, "sub")].join(""))}
      <h3>Scenarioer i modellen</h3>
      <div class="tw"><table><thead><tr><th class="l">Scenario</th><th>Rente</th><th>Ledighet</th><th>Yield</th><th>KPI</th></tr></thead><tbody>
      ${F.scenarier.map(s => `<tr class="${s.navn === F.scenario ? "sel sub" : ""}"><td class="l">${esc(s.navn)}${s.navn === F.scenario ? " (valgt)" : ""}</td><td>${f.pp(s.rente)}</td><td>${f.pp(s.ledighet, 1)}</td><td>${f.pp(s.yield)}</td><td>${f.pp(s.kpi, 1)}</td></tr>`).join("")}</tbody></table></div>
      <h3>Øvrig</h3>
      <div class="card"><ul class="checks">
        <li><span>Konsolidering</span><b>${esc(F.konsolidering)}</b></li><li><span>Skattesats</span><b>${f.p(F.skatt, 0)}</b></li>
        <li><span>Rentebegrensning anvendt</span><b>${esc(F.rentebegr)}</b></li><li><span>Administrasjonskostnader morselskap år 1</span><b>${f.n(F.morAdm)} TNOK</b></li></ul></div>`;
    chart("ch-f1", "line", d.years, [ds("NIBOR i scenario", F.nibor, css("--c1")), ds("NIBOR basis", F.niborBasis, css("--c4"), { borderDash: [5, 4] }), ds("KPI i scenario", F.kpi, css("--c3"))], { fmt: v => f.p(v, 1) });
  }

  /* ---------- Sammenligning ---------- */
  function pSammenligning() {
    const i = Y(), files = state.files, ref = files[0].data;
    const metr = [["Gjeld (TNOK)", k => k.gjeld[i], f.n], ["Eiendomsverdi (TNOK)", k => k.verdi[i], f.n], ["NOI konsern (TNOK)", k => k.noi[i], f.n],
      ["Rentekostnad inkl. swap (TNOK)", k => k.rk[i], f.n], ["Netto kontantstrøm (TNOK)", k => k.netto[i], f.n], ["Bankinnskudd (TNOK)", k => k.bank[i], f.n],
      ["Belåningsgrad (LTV)", k => k.ltv[i], f.p, "p"], ["Rentedekning (ICR)", k => k.icr[i], f.x, "x"], ["Gjeldsbetjeningsevne (DSCR)", k => k.dscr[i], f.x, "x"],
      ["Sikringsgrad", k => k.hg[i], f.p, "p"], ["Covenantbrudd", k => k.brudd[i], v => isNum(v) ? String(v) : "–", "c"]];
    const diff = (a, b, t) => !isNum(a) || !isNum(b) ? "–" : t === "p" ? f.pp(a - b, 1) : t === "x" ? minus((a - b >= 0 ? "+" : "") + (a - b).toLocaleString("nb-NO", { maximumFractionDigits: 2, minimumFractionDigits: 2 })) : t === "c" ? String(a - b) : minus((a - b >= 0 ? "+" : "") + nf.format(Math.round(a - b)));
    const head = `<thead><tr><th class="l">${yr(i)}</th>${files.map((x, j) => `<th>${esc(x.name)}<br><span style="font-weight:400;color:var(--muted)">${esc(x.data.fors.scenario)}</span></th>`).join("")}${files.slice(1).map(x => `<th>Endring ${esc(x.name)}</th>`).join("")}</tr></thead>`;
    const body = metr.map(([l, g, fm, t]) => `<tr><td class="l">${l}</td>${files.map(x => `<td>${fm(g(x.data.kons))}</td>`).join("")}${files.slice(1).map(x => `<td>${diff(g(x.data.kons), g(ref.kons), t)}</td>`).join("")}</tr>`).join("");
    const cols = ["--c1", "--c3", "--c6", "--c2", "--c5", "--c4"];
    $("#p-sammenligning").innerHTML = `
      <h2>Sammenligning av scenarioer</h2>
      <p class="lead">${files.length} filer er importert. Endringer er beregnet mot referansen, ${esc(files[0].name)}. Rekkefølgen styres av importrekkefølgen.</p>
      ${table(head, body)}
      <div class="grid2" style="margin-top:20px">
        <div class="card"><h4>Rentedekning (ICR)</h4><div class="chartbox"><canvas id="ch-c1"></canvas></div></div>
        <div class="card"><h4>Belåningsgrad (LTV)</h4><div class="chartbox"><canvas id="ch-c2"></canvas></div></div>
        <div class="card"><h4>Bankinnskudd (TNOK)</h4><div class="chartbox"><canvas id="ch-c3"></canvas></div></div>
        <div class="card"><h4>Netto kontantstrøm (TNOK)</h4><div class="chartbox"><canvas id="ch-c4"></canvas></div></div>
      </div>`;
    const years = D().years;
    chart("ch-c1", "line", years, files.map((x, j) => ds(x.name, x.data.kons.icr, css(cols[j % 6]))), { fmt: f.x, zero: false });
    chart("ch-c2", "line", years, files.map((x, j) => ds(x.name, x.data.kons.ltv, css(cols[j % 6]))), { fmt: v => f.p(v, 0) });
    chart("ch-c3", "line", years, files.map((x, j) => ds(x.name, x.data.kons.bank, css(cols[j % 6]))));
    chart("ch-c4", "bar", years, files.map((x, j) => ds(x.name, x.data.kons.netto, css(cols[j % 6]))));
  }

  /* ---------- utskrift ---------- */
  window.addEventListener("beforeprint", () => { document.querySelectorAll(".panel").forEach(p => p.style.display = p.dataset.print === "no" ? "none" : "block"); charts.forEach(c => c.resize()); });
  window.addEventListener("afterprint", () => { document.querySelectorAll(".panel").forEach(p => p.style.display = ""); charts.forEach(c => c.resize()); });
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => state.files.length && render());
  window.addEventListener("resize", () => document.documentElement.style.setProperty("--topbar-h", $("#topbar").offsetHeight + "px"));
  const h0 = location.hash.slice(1); if (TABS.some(t => t[0] === h0)) state.tab = h0;
})();
</script>
</body>
</html>
